# Receipt Management Platform environment example
# Static Phase 1 deployments can keep these blank and manage most settings in the UI.
# Self-hosted or future multi-user deployments can populate them before enabling server features.

# Database configuration
DATABASE_URL=./data/receipt-hub.sqlite
DATABASE_NAME=receipts
DATABASE_BACKUP_PATH=./backups
PORT=4173

# Auth secrets
AUTH_SESSION_SECRET=replace-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ALLOW_PUBLIC_REGISTRATION=true
SESSION_TTL_HOURS=168

# Google Drive backup configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER=appDataFolder

# Email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=receipts@example.com

# Storage configuration
STORAGE_DRIVER=indexeddb
STORAGE_MAX_RECEIPTS=10000
STORAGE_MAX_UPLOAD_MB=20
STORAGE_ZIP_EXPORT_PATH=./exports

# Security settings
APP_ENV=production
CORS_ALLOWED_ORIGINS=
CONTENT_SECURITY_POLICY_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
API_BODY_LIMIT_MB=20
LOG_LEVEL=info
